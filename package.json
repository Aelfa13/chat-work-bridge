{
  "name": "engineering-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first, read-only bridge from an MCP client to a registered Codex workspace.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "npm run build && node --test \"dist/tests/unit/**/*.test.js\""
  },
  "keywords": [
    "mcp",
    "codex",
    "local-first",
    "read-only"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.3"
  }
}
